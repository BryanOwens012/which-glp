# Supabase Database Connection
DATABASE_URL="postgresql://postgres:[PASSWORD]@[PROJECT-REF].supabase.co:5432/postgres"

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration (frontend URL)
FRONTEND_URL=http://localhost:3001

# Recommendation Engine API
REC_ENGINE_URL=http://127.0.0.1:8001

# HTTP edge — all optional; defaults live in src/lib/config.ts
# Extra CORS origins beyond the built-in allowlist (comma-separated bare origins, no path)
ALLOWED_ORIGINS=
# Set to false to refuse this project's Vercel preview origins
ALLOW_VERCEL_PREVIEW_ORIGINS=true
MAX_REQUEST_BODY_BYTES=1000000
# Milliseconds a shutdown waits for in-flight requests before exiting anyway
SHUTDOWN_TIMEOUT_MS=10000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_WINDOW_SECONDS=60
RATE_LIMIT_API_MAX_REQUESTS=300
RATE_LIMIT_PROBE_WINDOW_SECONDS=600
RATE_LIMIT_PROBE_MAX_REQUESTS=5
RATE_LIMIT_PROBE_BLOCK_SECONDS=3600

# Analytics (PostHog) — optional, analytics disabled if absent
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
